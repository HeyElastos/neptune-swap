{
  "schema": "elastos.capsule/v1",
  "name": "neptune-swap",
  "version": "0.1.0",
  "description": "Swap NPT privately: say what you want, solvers compete, settle on Neptune",
  "author": "local-development",
  "role": "app",
  "type": "web-projection",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": [
    "web",
    "facts",
    "affordances",
    "gates"
  ],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "neptune.swap",
      "version": "0.1.0",
      "description": "Neptune Swap: private swaps, the Neptune wallet, standing offers",
      "methods": [
        {
          "id": "networks.view",
          "description": "List the Neptune networks this Home can use",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://neptune/meta/networks",
          "operation": "networks"
        },
        {
          "id": "status.view",
          "description": "Show the local Neptune node's chain height",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://neptune/*",
          "operation": "status"
        },
        {
          "id": "wallet.use",
          "description": "Create, sync and use this Home's Neptune wallet (seed and keys stay in the provider)",
          "risk": "payment",
          "approval": "runtime_policy",
          "audit": "full",
          "resource": "elastos://neptune/*",
          "operation": "wallet"
        },
        {
          "id": "prices.view",
          "description": "Show USD reference prices; the Runtime asks the user first (the sources see this computer's address)",
          "risk": "read",
          "approval": "user",
          "audit": "summary",
          "resource": "elastos://neptune/prices",
          "operation": "prices"
        },
        {
          "id": "offers.sign",
          "description": "Sign a standing offer with this wallet's solver key (the key stays in the provider; at most 60 an hour)",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://neptune/*",
          "operation": "offer_sign"
        },
        {
          "id": "offers.carrier",
          "description": "Join, send on and read its own carrier topics only: neptune-swap/offers/main, neptune-swap/offers/test",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://peer/*",
          "operation": "gossip"
        },
        {
          "id": "evm.account",
          "description": "Ask elastOS Wallet to share one EVM account on Base with this app (the user approves in Wallet; 12 hours)",
          "risk": "rights",
          "approval": "user",
          "audit": "summary",
          "resource": "elastos://wallet/*",
          "operation": "request_accounts"
        },
        {
          "id": "evm.pay",
          "description": "Ask elastOS Wallet to send a transaction on Base: lock, claim or refund in the swap contract, or an exact token approval for it (the user approves each one in Wallet)",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/*",
          "operation": "request_transaction"
        },
        {
          "id": "evm.read",
          "description": "Typed chain reads on Base through the Runtime's chain provider: eth_blockNumber, eth_call, eth_getCode, eth_getLogs, eth_getTransactionReceipt",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://chain/*",
          "operation": "read"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
