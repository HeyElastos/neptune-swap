// Neptune Swap. Three tiers: the node is glanced at (a chip and its panel), the swap is
// the main area, the review is a sheet. Everything floats as frosted glass over the wallpaper.

import { Skin, Look, Sp, Rad, Ty, Ctl, Motion } from "tokens.slint";
import { Frost, Wallpaper, Glass } from "glass.slint";

export { Frost, Look }

export struct AssetView {
    letter: string,
    symbol: string,
    network: string,
    npt: bool,
    // False while the asset cannot be swapped without a bridge: listed, not selectable.
    offered: bool,
}

component Face inherits Rectangle {
    in property <AssetView> asset;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: root.asset.npt ? Skin.accent : Skin.surface3;
    Text {
        text: root.asset.letter;
        color: root.asset.npt ? Skin.on-accent : Skin.ink;
        font-size: Ty.caption;
        font-weight: Ty.bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Chevron inherits Path {
    width: 10px;
    height: 6px;
    viewbox-width: 10;
    viewbox-height: 6;
    commands: "M 1 1 L 5 5 L 9 1";
    stroke: Skin.muted;
    stroke-width: 1.5px;
    fill: transparent;
}

// A surface that answers the pointer: a clear rest lifts to the hover tint, a solid one steps
// toward the ink.
component Pressable inherits Rectangle {
    callback clicked;
    in property <color> rest: transparent;
    in property <color> hover-fill: Skin.hover;
    in property <bool> enabled: true;
    background: !root.enabled ? root.rest : touch.pressed ? root.hover-fill.mix(Skin.ink, 0.92) : touch.has-hover ? root.hover-fill : root.rest;
    animate background { duration: Motion.hover; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// HyButton: a primary is gold with its glow, a ghost one tone step above the glass.
component Button inherits Pressable {
    in property <string> text;
    in property <bool> primary: true;
    height: Ctl.m;
    min-width: label.preferred-width + 2 * Sp.l;
    border-radius: Rad.ctrl;
    opacity: root.enabled ? 1 : 0.4;
    rest: root.primary ? Skin.accent : Skin.ink.with-alpha(0.10);
    hover-fill: root.primary ? Skin.accent.mix(#FFFFFF, 0.92) : Skin.ink.with-alpha(0.16);
    drop-shadow-offset-y: root.primary && root.enabled ? 2px : 0px;
    drop-shadow-blur: root.primary && root.enabled ? 8px : 0px;
    drop-shadow-color: Skin.accent.with-alpha(0.25);
    label := Text {
        text: root.text;
        color: root.primary ? Skin.on-accent : Skin.ink;
        font-size: Ty.body;
        font-weight: root.primary ? Ty.strong : Ty.label;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// HySegmented: a track at the ink's 8 %, the chosen pill a tone up.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    height: 32px;
    border-radius: Rad.ctrl;
    background: Skin.track;
    HorizontalLayout {
        padding: 2px;
        for option[i] in root.options: Pressable {
            border-radius: 10px;
            rest: i == root.selected ? Skin.surface3 : transparent;
            hover-fill: i == root.selected ? Skin.surface3 : Skin.hover;
            min-width: text.preferred-width + 2 * Sp.m;
            clicked => { root.selected = i; }
            text := Text {
                text: option;
                font-size: Ty.small;
                font-weight: Ty.label;
                color: i == root.selected ? Skin.ink : Skin.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// One leg of the swap: a quiet well with the typed amount and the asset chip.
component Leg inherits Rectangle {
    in property <string> label;
    in property <AssetView> asset;
    in-out property <string> amount;
    // What the amount is worth ("≈ $250.00"), when prices are shown.
    in property <string> usd;
    // The chip's bottom right corner, for its popover.
    callback pick-asset(length, length);
    border-radius: Rad.ctrl;
    background: Skin.on-glass;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Skin.accent;
    height: column.preferred-height;
    column := VerticalLayout {
        padding-top: Sp.m;
        padding-bottom: Sp.m;
        padding-left: Sp.l;
        padding-right: Sp.m;
        spacing: Sp.xs;
        Text {
            text: root.label;
            color: Skin.muted;
            font-size: Ty.caption;
        }
        HorizontalLayout {
            spacing: Sp.m;
            Rectangle {
                horizontal-stretch: 1;
                height: Ctl.m;
                input := TextInput {
                    text <=> root.amount;
                    color: Skin.ink;
                    font-size: Ty.display;
                    font-weight: Ty.strong;
                    vertical-alignment: center;
                    single-line: true;
                    input-type: decimal;
                    selection-background-color: Skin.accent.with-alpha(0.35);
                }
                if root.amount == "": Text {
                    text: "0";
                    color: Skin.faint;
                    font-size: Ty.display;
                    font-weight: Ty.strong;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
            chip := Pressable {
                height: Ctl.m;
                border-radius: Rad.pill;
                rest: Skin.ink.with-alpha(0.08);
                hover-fill: Skin.ink.with-alpha(0.14);
                width: chip-row.preferred-width;
                clicked => { root.pick-asset(self.absolute-position.x + self.width, self.absolute-position.y + self.height); }
                chip-row := HorizontalLayout {
                    padding-left: Sp.s;
                    padding-right: Sp.m;
                    spacing: Sp.s;
                    VerticalLayout { alignment: center; Face { asset: root.asset; } }
                    Text {
                        text: root.asset.symbol;
                        color: Skin.ink;
                        font-size: Ty.body;
                        font-weight: Ty.strong;
                        vertical-alignment: center;
                    }
                    VerticalLayout { alignment: center; Chevron { } }
                }
            }
        }
        if root.usd != "": Text { text: root.usd; color: Skin.muted; font-size: Ty.caption; }
    }
}

// Three seed words on one line of the backup sheet.
export struct WordRow {
    a: string,
    b: string,
    c: string,
}

// A labelled text well, one line or several (a seed phrase).
component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> multi;
    in-out property <string> text;
    // One line of the input's font, measured, so the box shows whole lines only.
    property <length> line: probe.preferred-height;
    probe := Text { text: "Ag"; font-size: Ty.body; visible: false; }
    border-radius: Rad.ctrl;
    background: Skin.on-glass;
    border-width: input.has-focus ? 2px : 0px;
    border-color: Skin.accent;
    height: column.preferred-height;
    column := VerticalLayout {
        padding: Sp.m;
        spacing: Sp.xs;
        Text { text: root.label; color: Skin.muted; font-size: Ty.caption; }
        Rectangle {
            height: (root.multi ? 3 : 1) * root.line;
            clip: true;
            input := TextInput {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(parent.height, self.preferred-height);
                text <=> root.text;
                color: Skin.ink;
                font-size: Ty.body;
                single-line: !root.multi;
                wrap: root.multi ? char-wrap : no-wrap;
                vertical-alignment: top;
                selection-background-color: Skin.accent.with-alpha(0.35);
            }
            if root.text == "": Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                color: Skin.faint;
                font-size: Ty.body;
                vertical-alignment: top;
                horizontal-alignment: left;
            }
        }
    }
}

// One payment in the wallet's activity.
export struct ActivityRow {
    incoming: bool,
    // "+12.5" or "−10".
    amount: string,
    title: string,
    detail: string,
    pending: bool,
}

// An address handed out: which one, and what it received. A row opens it.
// The app's four places, as icons drawn on a 20 x 20 grid.
global Icons {
    out property <string> swap: "M 4 7 L 16 7 M 12 3 L 16 7 L 12 11 M 16 13 L 4 13 M 8 9 L 4 13 L 8 17";
    out property <string> market: "M 3 8 L 4.5 3.5 L 15.5 3.5 L 17 8 M 3 8 L 17 8 M 4 8 L 4 16.5 L 16 16.5 L 16 8 M 8 16.5 L 8 12 L 12 12 L 12 16.5";
    out property <string> activity: "M 2 10 L 6 10 L 8 4.5 L 12 15.5 L 14 10 L 18 10";
    out property <string> wallet: "M 3 6 L 17 6 L 17 16 L 3 16 Z M 3 6 L 14 3 L 15 6 M 13 11 L 15 11";
}

// One place in the navigation: a tab (icon over label) on a phone, a row in the side rail on
// a wide window. A dot marks something that wants a look (a swap running).
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    in property <bool> rail;
    in property <bool> dot;
    callback clicked;
    border-radius: Rad.ctrl;
    background: root.active && root.rail ? Skin.hover : touch.has-hover ? Skin.hover : transparent;
    animate background { duration: Motion.hover; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if !root.rail: VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                Path {
                    width: 20px;
                    height: 20px;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: root.icon;
                    stroke: root.active ? Skin.accent-text : Skin.muted;
                    stroke-width: 1.6px;
                    fill: transparent;
                }
                if root.dot: Rectangle { x: 17px; y: 0px; width: 7px; height: 7px; border-radius: 3.5px; background: Skin.accent; }
            }
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: Ty.caption;
            font-weight: root.active ? Ty.strong : Ty.label;
            color: root.active ? Skin.accent-text : Skin.muted;
        }
    }
    if root.rail: HorizontalLayout {
        padding-left: Sp.m;
        padding-right: Sp.m;
        spacing: Sp.m;
        VerticalLayout {
            alignment: center;
            Path {
                width: 18px;
                height: 18px;
                viewbox-width: 20;
                viewbox-height: 20;
                commands: root.icon;
                stroke: root.active ? Skin.accent-text : Skin.muted;
                stroke-width: 1.6px;
                fill: transparent;
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: Ty.body;
            font-weight: root.active ? Ty.strong : Ty.label;
            color: root.active ? Skin.ink : Skin.muted;
        }
        if root.dot: VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Skin.accent; } }
    }
}

export struct StepRow {
    text: string,
    // "done", "now", "todo" or "failed"
    state: string,
}

// The swap in progress: what it is, where it stands, the steps of its direction.
component SwapCard inherits VerticalLayout {
    in property <string> title;
    in property <string> line;
    in property <[StepRow]> steps;
    in property <bool> finished;
    callback dismiss();
    padding: Sp.l;
    spacing: Sp.s;
    HorizontalLayout {
        spacing: Sp.s;
        Text { text: root.finished ? "Swap" : "Swap in progress"; color: Skin.ink; font-size: Ty.body; font-weight: Ty.strong; vertical-alignment: center; }
        Text { text: root.title; color: Skin.muted; font-size: Ty.caption; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; horizontal-alignment: right; }
    }
    for step in root.steps: HorizontalLayout {
        spacing: Sp.s;
        Text {
            width: 18px;
            text: step.state == "done" ? "✓" : step.state == "now" ? "●" : step.state == "failed" ? "✕" : "○";
            color: step.state == "done" ? Skin.good : step.state == "now" ? Skin.accent-text : step.state == "failed" ? Skin.danger : Skin.faint;
            font-size: Ty.small;
            vertical-alignment: center;
        }
        Text {
            text: step.text;
            color: step.state == "todo" ? Skin.faint : Skin.ink;
            font-size: Ty.small;
            font-weight: step.state == "now" ? Ty.strong : 400;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
    Text { text: root.line; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }
    Text {
        text: "Funds stay in your Neptune wallet and your Wallet account until each step checks out; keep this page or Home open while it runs.";
        color: Skin.faint;
        font-size: Ty.caption;
        wrap: word-wrap;
        visible: !root.finished;
    }
    if root.finished: Text {
        text: "Close";
        color: Skin.accent-text;
        font-size: Ty.small;
        TouchArea { mouse-cursor: pointer; clicked => { root.dismiss(); } }
    }
}

export struct AddressRow {
    title: string,
    detail: string,
    current: bool,
}

component AddressItem inherits Rectangle {
    in property <AddressRow> entry;
    callback open();
    height: 46px;
    HorizontalLayout {
        spacing: Sp.m;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.entry.title;
                color: Skin.ink;
                font-size: Ty.body;
                font-weight: root.entry.current ? Ty.strong : 400;
                overflow: elide;
            }
            Text { text: root.entry.detail; color: Skin.muted; font-size: Ty.caption; overflow: elide; }
        }
        Text { text: "›"; color: Skin.muted; font-size: Ty.title; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.open(); } }
}

component ActivityItem inherits Rectangle {
    in property <ActivityRow> entry;
    height: 46px;
    HorizontalLayout {
        spacing: Sp.m;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: root.entry.incoming ? Skin.good.with-alpha(0.16) : Skin.ink.with-alpha(0.08);
                Text {
                    text: root.entry.incoming ? "↓" : "↑";
                    color: root.entry.incoming ? Skin.good : Skin.ink;
                    font-size: Ty.body;
                    font-weight: Ty.strong;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text { text: root.entry.title; color: Skin.ink; font-size: Ty.body; overflow: elide; }
            Text {
                text: root.entry.detail;
                color: root.entry.pending ? Skin.connecting : Skin.muted;
                font-size: Ty.caption;
                overflow: elide;
            }
        }
        Text {
            text: root.entry.amount + " NPT";
            color: root.entry.incoming ? Skin.good : Skin.ink;
            font-size: Ty.body;
            font-weight: Ty.strong;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Open offers for the pair the swap form shows. A row fills the form from it.
component OffersCard inherits VerticalLayout {
    in property <string> pair;
    in property <string> status;
    in property <[AddressRow]> rows;
    in property <bool> on;
    callback take(int);
    callback show();
    padding: Sp.l;
    spacing: Sp.s;
    HorizontalLayout {
        spacing: Sp.s;
        Text { text: "Open offers"; color: Skin.ink; font-size: Ty.body; font-weight: Ty.strong; vertical-alignment: center; }
        Text { text: root.pair; color: Skin.muted; font-size: Ty.caption; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    Text { text: root.status; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }
    if !root.on: Text {
        text: "Show open offers";
        color: Skin.accent-text;
        font-size: Ty.small;
        TouchArea { mouse-cursor: pointer; clicked => { root.show(); } }
    }
    for entry[i] in root.rows: AddressItem { entry: entry; open => { root.take(i); } }
}

// Trading as a solver: standing offers published to everyone running the app.
component SolverCard inherits VerticalLayout {
    in property <string> did;
    in-out property <int> side;
    in-out property <int> other;
    in-out property <string> price;
    in-out property <string> min-npt;
    in-out property <string> max-npt;
    in property <string> error;
    in property <string> note;
    in property <bool> busy;
    in property <[AddressRow]> mine;
    property <[string]> others: ["USDC", "ETH", "ELA", "BTC"];
    callback publish();
    callback withdraw(int);
    padding: Sp.l;
    spacing: Sp.m;
    Text { text: "Trade as a solver"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    Text {
        text: "Publish a standing offer. Everyone running Neptune Swap sees it, signed with your solver ID; takers then send you a sealed request. Offers stay live while this page is open.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.did != "": Text { text: "Your solver ID: " + root.did; color: Skin.muted; font-size: Ty.caption; overflow: elide; }
    HorizontalLayout {
        alignment: start;
        Segmented { options: ["I sell NPT", "I buy NPT"]; selected <=> root.side; }
    }
    HorizontalLayout {
        alignment: start;
        Segmented { options: root.others; selected <=> root.other; }
    }
    Field { label: "Price of 1 NPT in " + root.others[root.other]; placeholder: "0.15"; text <=> root.price; }
    HorizontalLayout {
        spacing: Sp.m;
        Field { label: "Least NPT"; placeholder: "10"; text <=> root.min-npt; horizontal-stretch: 1; preferred-width: 0px; }
        Field { label: "Most NPT"; placeholder: "1000"; text <=> root.max-npt; horizontal-stretch: 1; preferred-width: 0px; }
    }
    if root.error != "": Text { text: root.error; color: Skin.danger; font-size: Ty.small; wrap: word-wrap; }
    if root.note != "": Text { text: root.note; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        Button { text: root.busy ? "Publishing…" : "Publish offer"; enabled: !root.busy; clicked => { root.publish(); } }
    }
    if root.mine.length > 0: Rectangle { height: 1px; background: Skin.edge; }
    if root.mine.length > 0: Text { text: "Your offers · tap one to withdraw it"; color: Skin.muted; font-size: Ty.caption; }
    for entry[i] in root.mine: AddressItem { entry: entry; open => { root.withdraw(i); } }
}

// The Neptune wallet. The seed lives with this Home's Neptune provider; the page shows the
// phrase once, when it is made, and sends a typed one once, to import it.
component WalletCard inherits VerticalLayout {
    // "loading", "none", "phrase", "import" or "ready".
    in property <string> state;
    in property <bool> busy;
    in property <string> error;
    // The seed, two words to a row: readable at any width (c stays empty).
    in property <[WordRow]> phrase-pairs;
    in property <string> balance;
    in property <string> spendable;
    in property <string> sync-label;
    in property <string> address-short;
    in property <string> copy-note;
    in-out property <string> import-phrase;
    in-out property <string> import-height;
    // Sending: the form, then a review of exactly what will be paid.
    in-out property <string> send-to;
    in-out property <string> send-amount;
    in-out property <string> send-fee;
    in property <string> send-summary;
    in property <string> notice;
    // Activity: the latest few on the overview, all in "history".
    in property <[ActivityRow]> activity;
    in property <bool> activity-more;
    // Receive: 0 private (Generation), 1 short (EC Hybrid, with a QR code).
    in-out property <int> receive-kind;
    in property <image> qr;
    in property <bool> qr-shown;
    // Which address the receive view shows ("Private address 2, the newest").
    in property <string> receive-label;
    // Every address of the chosen kind handed out, newest first.
    in property <[AddressRow]> address-rows;
    callback show-addresses();
    callback open-address(int);
    callback paste-address();
    callback start-receive();
    callback close-view();
    callback new-address();
    callback show-history();
    callback start-send();
    callback cancel-send();
    callback review-send();
    callback confirm-send();
    callback create();
    callback start-import();
    callback cancel-import();
    callback import();
    callback phrase-done();
    callback sync();
    callback copy-address();
    padding: Sp.l;
    spacing: Sp.m;
    // Every element is a direct child, shown by state: wrapped text inside a nested layout
    // would be measured as one line and the card would clip.
    if root.state == "loading": Text { text: "Opening the wallet…"; color: Skin.muted; font-size: Ty.small; }

    // No wallet yet.
    if root.state == "none": Text { text: "Your Neptune wallet"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "none": Text {
        text: "No wallet on this Home yet. Its seed stays with this Home's Neptune provider; this page never stores it.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.state == "none": HorizontalLayout {
        spacing: Sp.s;
        alignment: start;
        Button { text: "Create wallet"; enabled: !root.busy; clicked => { root.create(); } }
        Button { text: "Import seed"; primary: false; enabled: !root.busy; clicked => { root.start-import(); } }
    }

    // The new seed, shown once.
    if root.state == "phrase": Text { text: "Write down your seed"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "phrase": Text {
        text: "These 18 words are the only way to restore this wallet, and anyone who has them can spend it. Write them on paper and keep them offline. They are not shown again.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.state == "phrase": Rectangle {
        border-radius: Rad.ctrl;
        background: Skin.on-glass;
        height: words.preferred-height;
        words := VerticalLayout {
            padding: Sp.m;
            spacing: Sp.xs;
            for row in root.phrase-pairs: HorizontalLayout {
                spacing: Sp.m;
                for word in [row.a, row.b]: Text {
                    // Equal columns, whatever the words' widths.
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    horizontal-alignment: left;
                    text: word;
                    color: Skin.ink;
                    font-size: Ty.body;
                    font-weight: Ty.label;
                }
            }
        }
    }
    if root.state == "phrase": HorizontalLayout {
        alignment: end;
        Button { text: "I wrote it down"; clicked => { root.phrase-done(); } }
    }

    // Import.
    if root.state == "import": Text { text: "Import a seed"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "import": Field {
        label: "Seed phrase";
        placeholder: "18 words, separated by spaces";
        multi: true;
        text <=> root.import-phrase;
    }
    if root.state == "import": Field {
        label: "Scan from block";
        placeholder: "0 scans from the first block";
        text <=> root.import-height;
    }
    if root.state == "import": HorizontalLayout {
        alignment: end;
        spacing: Sp.s;
        Button { text: "Cancel"; primary: false; enabled: !root.busy; clicked => { root.cancel-import(); } }
        Button { text: root.busy ? "Importing…" : "Import"; enabled: !root.busy; clicked => { root.import(); } }
    }

    // The wallet.
    if root.state == "ready": Text { text: "Balance"; color: Skin.muted; font-size: Ty.caption; }
    if root.state == "ready": Text { text: root.balance + " NPT"; color: Skin.ink; font-size: Ty.display; font-weight: Ty.strong; }
    if root.state == "ready" && root.spendable != "": Text { text: root.spendable; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }
    if root.state == "ready": Text { text: root.sync-label; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }
    if root.state == "ready": HorizontalLayout {
        alignment: end;
        spacing: Sp.s;
        Button { text: root.busy ? "Syncing…" : "Sync"; primary: false; enabled: !root.busy; clicked => { root.sync(); } }
        Button { text: "Receive"; primary: false; clicked => { root.start-receive(); } }
        Button { text: "Send"; enabled: !root.busy; clicked => { root.start-send(); } }
    }
    if root.state == "ready" && root.notice != "": Text { text: root.notice; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }

    // Activity: the latest few.
    if root.state == "ready": Rectangle { height: 1px; background: Skin.edge; }
    if root.state == "ready": HorizontalLayout {
        Text { text: "Activity"; color: Skin.muted; font-size: Ty.caption; vertical-alignment: center; horizontal-stretch: 1; }
        if root.activity-more: Text {
            text: "All activity";
            color: Skin.accent-text;
            font-size: Ty.small;
            vertical-alignment: center;
            TouchArea { mouse-cursor: pointer; clicked => { root.show-history(); } }
        }
    }
    if root.state == "ready" && root.activity.length == 0: Text { text: "No payments yet."; color: Skin.muted; font-size: Ty.small; }
    if root.state == "ready": VerticalLayout {
        for entry in root.activity: ActivityItem { entry: entry; }
    }

    // Receive.
    if root.state == "receive": Text { text: "Receive NPT"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "receive": HorizontalLayout {
        alignment: start;
        Segmented { options: ["Private", "Short"]; selected <=> root.receive-kind; }
    }
    if root.state == "receive": Text {
        text: root.receive-kind == 0
            ? "A Generation address: the most private kind, and safe to reuse. Its QR code is dense; scan it up close, or copy the address."
            : "An EC hybrid address: shorter and easier to share. Give each one to a single person: if it is shared widely, a future quantum computer could reveal what it received, though never spend it.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.state == "receive" && root.qr-shown: HorizontalLayout {
        alignment: center;
        // Dark on white whatever the look: scanners need the contrast.
        Rectangle {
            width: 216px;
            height: 216px;
            border-radius: Rad.ctrl;
            background: #FFFFFF;
            Image { width: 200px; height: 200px; source: root.qr; image-rendering: pixelated; }
        }
    }
    if root.state == "receive": HorizontalLayout {
        spacing: Sp.s;
        Text {
            text: root.receive-label;
            color: Skin.muted;
            font-size: Ty.caption;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: "All addresses";
            color: Skin.accent-text;
            font-size: Ty.small;
            vertical-alignment: center;
            TouchArea { mouse-cursor: pointer; clicked => { root.show-addresses(); } }
        }
    }
    if root.state == "receive": Rectangle {
        border-radius: Rad.ctrl;
        background: Skin.on-glass;
        height: Ctl.m + Sp.s;
        // One line, elided; Copy takes it whole.
        Text {
            x: Sp.m;
            width: parent.width - 2 * Sp.m;
            text: root.address-short;
            color: Skin.ink;
            font-size: Ty.small;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    if root.state == "receive": HorizontalLayout {
        alignment: end;
        spacing: Sp.s;
        Button { text: "New address"; primary: false; enabled: !root.busy; clicked => { root.new-address(); } }
        Button { text: "Copy"; primary: false; clicked => { root.copy-address(); } }
        Button { text: "Done"; clicked => { root.close-view(); } }
    }
    if root.state == "receive" && root.copy-note != "": Text { text: root.copy-note; color: Skin.muted; font-size: Ty.small; wrap: word-wrap; }

    // Every address handed out.
    if root.state == "addresses": Text { text: "Your addresses"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "addresses": HorizontalLayout {
        alignment: start;
        Segmented { options: ["Private", "Short"]; selected <=> root.receive-kind; }
    }
    if root.state == "addresses": Text {
        text: "Every address this wallet has handed out. All of them keep receiving; open one to copy it or show its QR code.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.state == "addresses": VerticalLayout {
        for entry[i] in root.address-rows: AddressItem { entry: entry; open => { root.open-address(i); } }
    }
    if root.state == "addresses": HorizontalLayout {
        alignment: end;
        Button { text: "Back"; primary: false; clicked => { root.start-receive(); } }
    }

    // All activity.
    if root.state == "history": Text { text: "Activity"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "history" && root.activity.length == 0: Text { text: "No payments yet."; color: Skin.muted; font-size: Ty.small; }
    if root.state == "history": VerticalLayout {
        for entry in root.activity: ActivityItem { entry: entry; }
    }
    if root.state == "history": HorizontalLayout {
        alignment: end;
        Button { text: "Back"; primary: false; clicked => { root.close-view(); } }
    }

    // Send: the form.
    if root.state == "send": Text { text: "Send NPT"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "send": Field {
        label: "To";
        placeholder: "A Neptune address";
        multi: true;
        text <=> root.send-to;
    }
    if root.state == "send": HorizontalLayout {
        alignment: start;
        Button { text: "Paste address"; primary: false; clicked => { root.paste-address(); } }
    }
    if root.state == "send": HorizontalLayout {
        spacing: Sp.m;
        // Equal halves, whatever is typed.
        Field { label: "Amount (NPT)"; placeholder: "0"; text <=> root.send-amount; horizontal-stretch: 1; preferred-width: 0px; }
        Field { label: "Fee (NPT)"; placeholder: "0.05"; text <=> root.send-fee; horizontal-stretch: 1; preferred-width: 0px; }
    }
    if root.state == "send": HorizontalLayout {
        alignment: end;
        spacing: Sp.s;
        Button { text: "Cancel"; primary: false; clicked => { root.cancel-send(); } }
        Button { text: "Review"; clicked => { root.review-send(); } }
    }

    // Send: the review. Nothing leaves before Confirm.
    if root.state == "confirm": Text { text: "Confirm payment"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; }
    if root.state == "confirm": Rectangle {
        border-radius: Rad.ctrl;
        background: Skin.on-glass;
        height: summary.preferred-height;
        summary := VerticalLayout {
            padding: Sp.m;
            Text { text: root.send-summary; color: Skin.ink; font-size: Ty.body; wrap: word-wrap; }
        }
    }
    if root.state == "confirm" && root.notice != "": Text { text: root.notice; color: Skin.ink; font-size: Ty.small; wrap: word-wrap; }
    if root.state == "confirm": Text {
        text: "A payment cannot be undone. Check the address before you confirm.";
        color: Skin.muted;
        font-size: Ty.small;
        wrap: word-wrap;
    }
    if root.state == "confirm": HorizontalLayout {
        alignment: end;
        spacing: Sp.s;
        Button { text: "Back"; primary: false; enabled: !root.busy; clicked => { root.cancel-send(); } }
        Button { text: root.busy ? "Sending…" : "Confirm and send"; enabled: !root.busy; clicked => { root.confirm-send(); } }
    }

    if root.error != "": Text {
        text: root.error;
        color: Skin.danger;
        font-size: Ty.small;
        wrap: word-wrap;
    }
}

// A row in a popover list.
component Row inherits Pressable {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> chosen;
    in property <AssetView> asset;
    in property <bool> with-face;
    height: root.subtitle == "" ? Ctl.m : 52px;
    border-radius: Rad.ctrl;
    HorizontalLayout {
        padding-left: Sp.m;
        padding-right: Sp.m;
        spacing: Sp.m;
        if root.with-face: VerticalLayout { alignment: center; Face { asset: root.asset; } }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.title; color: Skin.ink; font-size: Ty.body; }
            if root.subtitle != "": Text { text: root.subtitle; color: Skin.muted; font-size: Ty.caption; }
        }
        Text {
            text: "✓";
            visible: root.chosen;
            color: Skin.accent-text;
            font-size: Ty.body;
            font-weight: Ty.strong;
            vertical-alignment: center;
        }
    }
}

// A popover: anchored, sized to its content, fading in from 0.4 as it rises 10 px.
component Popover inherits Glass {
    in property <bool> open;
    in property <length> anchor-y;
    opacity: root.open ? 1 : 0;
    visible: self.opacity > 0.01;
    y: root.anchor-y + (root.open ? 0px : Motion.overlay-rise);
    animate opacity, y {
        duration: root.open ? Motion.overlay-in : Motion.overlay-out;
        easing: Motion.ease;
    }
}

export component AppWindow inherits Window {
    title: "Neptune Swap";
    preferred-width: 520px;
    preferred-height: 760px;
    min-width: 320px;
    min-height: 520px;
    background: Skin.base;
    default-font-size: Ty.body;

    in property <[AssetView]> assets;
    in-out property <int> give-index: 1;
    in-out property <int> want-index: 0;
    in-out property <string> give-amount;
    in-out property <string> want-amount;
    in-out property <int> ttl-index: 1;
    in property <string> form-error;
    // USD reference prices: "off" (not asked), "asking" (waiting for Home's
    // approval or the sources), "on", "denied".
    in property <string> prices-state: "off";
    in property <string> give-usd;
    in property <string> want-usd;
    // The unit prices and how the asked amount compares with the market.
    in property <string> price-note;
    callback show-prices();
    callback amounts-changed();
    // The other chain's side: "" (nothing to say), "connect", "asking",
    // "connected" or "info", with its line of text.
    // Open offers for the form's pair, and this Home's own as a solver.
    in property <string> offers-pair;
    in property <string> offers-status;
    in property <[AddressRow]> offer-rows;
    callback take-offer(int);
    in property <bool> offers-on;
    callback show-offers();
    in property <string> solver-did;
    in-out property <int> solver-side;
    in-out property <int> solver-other;
    in-out property <string> solver-price;
    in-out property <string> solver-min;
    in-out property <string> solver-max;
    in property <string> solver-error;
    in property <string> solver-note;
    in property <bool> solver-busy;
    in property <[AddressRow]> solver-mine;
    callback publish-offer();
    callback withdraw-offer(int);
    in property <string> other-leg-state;
    in property <string> other-leg;
    callback connect-wallet();
    changed give-amount => { root.amounts-changed(); }
    changed want-amount => { root.amounts-changed(); }
    changed give-index => { root.amounts-changed(); }
    changed want-index => { root.amounts-changed(); }

    // The node: "idle", "ok", "warn" or "error".
    in property <string> node-state: "idle";
    in property <string> node-label: "Node";
    in property <string> node-detail;
    in property <[string]> networks;
    in property <int> network-index;

    // The review sheet.
    in-out property <bool> review-open;
    in property <bool> send-ready;
    in property <string> send-note;
    callback send-swap();
    in property <bool> swap-on;
    in property <string> swap-title;
    in property <string> swap-line;
    in property <bool> swap-finished;
    in property <[StepRow]> swap-steps;
    callback swap-dismiss();
    callback swap-resume();
    in property <string> sum-give;
    in property <string> sum-want;
    in property <string> sum-until;
    in property <string> review-json;
    property <bool> show-json;

    // 0: the swap, 1: the wallet, 2: offers as a solver.
    // The page shown: 0 Swap, 1 Wallet, 2 Market, 3 Activity (the numbers Rust uses).
    in-out property <int> page;
    // A wide window gets a side rail; a phone a tab bar at the bottom.
    property <bool> wide: root.width >= 760px;
    property <[{label: string, icon: string, page: int}]> tabs: [
        { label: "Swap", icon: Icons.swap, page: 0 },
        { label: "Market", icon: Icons.market, page: 2 },
        { label: "Activity", icon: Icons.activity, page: 3 },
        { label: "Wallet", icon: Icons.wallet, page: 1 },
    ];
    pure function tab-of(page: int) -> int {
        page == 0 ? 0 : page == 2 ? 1 : page == 3 ? 2 : 3
    }
    callback page-changed(int);
    changed page => { root.page-changed(self.page); }

    // The wallet card (see WalletCard).
    in property <string> wallet-state: "loading";
    in property <bool> wallet-busy;
    in property <string> wallet-error;
    in property <[WordRow]> wallet-phrase-pairs;
    in property <string> wallet-balance;
    in property <string> wallet-spendable;
    in property <string> wallet-sync-label;
    in property <string> wallet-address-short;
    in property <string> wallet-copy-note;
    in-out property <string> wallet-import-phrase;
    in-out property <string> wallet-import-height;
    in-out property <string> wallet-send-to;
    in-out property <string> wallet-send-amount;
    in-out property <string> wallet-send-fee: "0.05";
    in property <string> wallet-send-summary;
    in property <string> wallet-notice;
    in property <[ActivityRow]> wallet-activity;
    in property <bool> wallet-activity-more;
    in-out property <int> wallet-receive-kind;
    in property <image> wallet-qr;
    in property <bool> wallet-qr-shown;
    in property <string> wallet-receive-label;
    in property <[AddressRow]> wallet-address-rows;
    callback wallet-show-addresses();
    callback wallet-open-address(int);
    callback wallet-paste-address();
    callback wallet-start-receive();
    callback wallet-close-view();
    callback wallet-new-address();
    callback wallet-show-history();
    callback wallet-receive-kind-changed(int);
    changed wallet-receive-kind => { root.wallet-receive-kind-changed(self.wallet-receive-kind); }
    callback wallet-start-send();
    callback wallet-cancel-send();
    callback wallet-review-send();
    callback wallet-confirm-send();
    callback wallet-create();
    callback wallet-start-import();
    callback wallet-cancel-import();
    callback wallet-import();
    callback wallet-phrase-done();
    callback wallet-sync();
    callback wallet-copy-address();

    // Which popover is open: "", "node", "give" or "want".
    in-out property <string> popover;
    property <length> pop-right;
    property <length> pop-top;

    callback review();
    callback pick-network(int);
    callback refresh();

    init => {
        Frost.width = self.width;
        Frost.height = self.height;
    }
    changed width => { Frost.width = self.width; }
    changed height => { Frost.height = self.height; }

    function pick-asset(side: string, index: int) {
        if side == "give" {
            if index == root.want-index { root.want-index = root.give-index; }
            root.give-index = index;
        } else {
            if index == root.give-index { root.give-index = root.want-index; }
            root.want-index = index;
        }
        root.popover = "";
    }

    function flip() {
        let index = root.give-index;
        root.give-index = root.want-index;
        root.want-index = index;
        let amount = root.give-amount;
        root.give-amount = root.want-amount;
        root.want-amount = amount;
    }

    // Development screenshots: open a popover as if its trigger was clicked.
    public function demo-open(name: string) {
        if name == "node" {
            root.open-popover(name, node-chip.absolute-position.x + node-chip.width, node-chip.absolute-position.y + node-chip.height);
        } else if name == "give" {
            root.open-popover(name, give-leg.absolute-position.x + give-leg.width - Sp.m, give-leg.absolute-position.y + give-leg.height - Sp.m);
        } else {
            root.open-popover(name, want-leg.absolute-position.x + want-leg.width - Sp.m, want-leg.absolute-position.y + want-leg.height - Sp.m);
        }
    }

    function open-popover(name: string, right: length, bottom: length) {
        if root.popover == name {
            root.popover = "";
        } else {
            root.pop-right = right;
            root.pop-top = bottom + Sp.s;
            root.popover = name;
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.popover != "" { root.popover = ""; return accept; }
                if root.review-open { root.review-open = false; return accept; }
            }
            reject
        }

        Wallpaper { }

        VerticalLayout {
            // The bar: where you are, and the node, glanced at.
            HorizontalLayout {
                height: 48px;
                padding-left: Sp.l;
                padding-right: Sp.l;
                spacing: Sp.m;
                Text {
                    // Its size never feeds back into the window's: the title elides instead.
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    overflow: elide;
                    text: root.wide ? "Neptune Swap" : root.tabs[root.tab-of(root.page)].label;
                    color: Skin.ink;
                    font-size: root.wide ? Ty.title : Ty.display;
                    font-weight: Ty.bold;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    node-chip := Glass {
                        radius: Rad.pill;
                        floating: false;
                        height: Ctl.s;
                        width: node-text.preferred-width + 2 * Sp.m + 8px + Sp.s;
                        HorizontalLayout {
                            padding-left: Sp.m;
                            padding-right: Sp.m;
                            spacing: Sp.s;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.node-state == "ok" ? Skin.good : root.node-state == "warn" ? Skin.connecting : root.node-state == "error" ? Skin.danger : Skin.faint;
                                }
                            }
                            node-text := Text {
                                text: root.node-label;
                                color: Skin.ink;
                                font-size: Ty.small;
                                font-weight: Ty.label;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-popover("node", node-chip.absolute-position.x + node-chip.width, node-chip.absolute-position.y + node-chip.height); }
                        }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                min-height: 0px;
                // A wide window: the places as a side rail.
                if root.wide: VerticalLayout {
                    width: 196px;
                    padding-left: Sp.m;
                    padding-right: Sp.s;
                    padding-top: Sp.s;
                    spacing: 2px;
                    alignment: start;
                    for tab in root.tabs: NavItem {
                        height: 38px;
                        rail: true;
                        label: tab.label;
                        icon: tab.icon;
                        active: root.page == tab.page;
                        dot: tab.page == 3 && root.swap-on && !root.swap-finished;
                        clicked => { root.page = tab.page; }
                    }
                }

                // The page scrolls under the bar; the lane is at most 520 wide.
                Flickable {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, page.preferred-height);
                    page := HorizontalLayout {
                    // Pinned to the top: a short page would otherwise sit centred.
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: self.preferred-height;
                    alignment: center;
                    padding-left: Sp.l;
                    padding-right: Sp.l;
                    padding-bottom: Sp.xl;
                    lane := VerticalLayout {
                        preferred-width: 520px;
                        max-width: 520px;
                        padding-top: Sp.xs;
                        spacing: Sp.m;
                        // The node's details open here, under its chip.
                    if root.popover == "node": Glass {
                        radius: Rad.ctrl;
                        floating: false;
                        height: node-list.preferred-height;
                        node-list := VerticalLayout {
                            padding: Sp.s;
                            // Text lines up with the rows' titles.
                            VerticalLayout {
                                padding-left: Sp.m;
                                padding-right: Sp.m;
                                padding-bottom: Sp.s;
                                Text {
                                    text: "Neptune node";
                                    color: Skin.muted;
                                    font-size: Ty.caption;
                                    height: 28px;
                                    vertical-alignment: center;
                                }
                                if root.node-detail != "": Text {
                                    text: root.node-detail;
                                    color: Skin.ink;
                                    font-size: Ty.small;
                                    wrap: word-wrap;
                                }
                            }
                            for network[i] in root.networks: Row {
                                title: network;
                                chosen: i == root.network-index;
                                clicked => { root.popover = ""; root.pick-network(i); }
                            }
                            if root.networks.length > 0: Row {
                                title: "Check again";
                                clicked => { root.popover = ""; root.refresh(); }
                            }
                        }
                    }

                        // A swap running, from any page: one tap to follow it.
                        if root.swap-on && !root.swap-finished && root.page != 3: Glass {
                            radius: Rad.pill;
                            height: 36px;
                            HorizontalLayout {
                                padding-left: Sp.l;
                                padding-right: Sp.l;
                                spacing: Sp.s;
                                VerticalLayout { alignment: center; Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: Skin.accent; } }
                                Text { text: "Swap running · " + root.swap-title; color: Skin.ink; font-size: Ty.small; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                Text { text: "View"; color: Skin.accent-text; font-size: Ty.small; font-weight: Ty.strong; vertical-alignment: center; }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.page = 3; } }
                        }
                    if root.page == 2: Glass {
                        height: offers-card.preferred-height;
                        offers-card := OffersCard {
                            // Known width, so wrapped lines count in its height.
                            width: parent.width;
                            pair: root.offers-pair;
                            status: root.offers-status;
                            rows: root.offer-rows;
                            on: root.offers-on;
                            take(i) => { root.take-offer(i); root.page = 0; }
                            show => { root.show-offers(); }
                        }
                    }
                    if root.page == 2: Glass {
                        height: solver-card.preferred-height;
                        solver-card := SolverCard {
                            // Known width, so wrapped lines count in its height.
                            width: parent.width;
                            did: root.solver-did;
                            side <=> root.solver-side;
                            other <=> root.solver-other;
                            price <=> root.solver-price;
                            min-npt <=> root.solver-min;
                            max-npt <=> root.solver-max;
                            error: root.solver-error;
                            note: root.solver-note;
                            busy: root.solver-busy;
                            mine: root.solver-mine;
                            publish => { root.publish-offer(); }
                            withdraw(i) => { root.withdraw-offer(i); }
                        }
                    }
                    if root.page == 1: Glass {
                        height: wallet-card.preferred-height;
                        wallet-card := WalletCard {
                            // Known width, so wrapped lines count in its height.
                            width: parent.width;
                            state: root.wallet-state;
                            busy: root.wallet-busy;
                            error: root.wallet-error;
                            phrase-pairs: root.wallet-phrase-pairs;
                            balance: root.wallet-balance;
                            spendable: root.wallet-spendable;
                            sync-label: root.wallet-sync-label;
                            address-short: root.wallet-address-short;
                            copy-note: root.wallet-copy-note;
                            import-phrase <=> root.wallet-import-phrase;
                            import-height <=> root.wallet-import-height;
                            send-to <=> root.wallet-send-to;
                            send-amount <=> root.wallet-send-amount;
                            send-fee <=> root.wallet-send-fee;
                            send-summary: root.wallet-send-summary;
                            notice: root.wallet-notice;
                            activity: root.wallet-activity;
                            activity-more: root.wallet-activity-more;
                            receive-kind <=> root.wallet-receive-kind;
                            qr: root.wallet-qr;
                            qr-shown: root.wallet-qr-shown;
                            receive-label: root.wallet-receive-label;
                            address-rows: root.wallet-address-rows;
                            show-addresses => { root.wallet-show-addresses(); }
                            open-address(i) => { root.wallet-open-address(i); }
                            paste-address => { root.wallet-paste-address(); }
                            start-receive => { root.wallet-start-receive(); }
                            close-view => { root.wallet-close-view(); }
                            new-address => { root.wallet-new-address(); }
                            show-history => { root.wallet-show-history(); }
                            start-send => { root.wallet-start-send(); }
                            cancel-send => { root.wallet-cancel-send(); }
                            review-send => { root.wallet-review-send(); }
                            confirm-send => { root.wallet-confirm-send(); }
                            create => { root.wallet-create(); }
                            start-import => { root.wallet-start-import(); }
                            cancel-import => { root.wallet-cancel-import(); }
                            import => { root.wallet-import(); }
                            phrase-done => { root.wallet-phrase-done(); }
                            sync => { root.wallet-sync(); }
                            copy-address => { root.wallet-copy-address(); }
                        }
                    }
                    Glass {
                        // The swap keeps its place in the tree (its legs anchor popovers) and
                        // folds away on the wallet page.
                        visible: root.page == 0;
                        height: root.page == 0 ? card.preferred-height : 0px;
                        card := VerticalLayout {
                            padding: Sp.l;
                            spacing: Sp.m;
                            give-leg := Leg {
                                label: "You give";
                                asset: root.assets[root.give-index];
                                amount <=> root.give-amount;
                                usd: root.give-usd;
                                pick-asset(right, bottom) => { root.open-popover("give", right, bottom); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                height: Ctl.m - 2 * Sp.m;
                                flip-button := Pressable {
                                    width: Ctl.m;
                                    height: Ctl.m;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Ctl.m / 2;
                                    rest: Skin.sheet.with-alpha(0.9);
                                    hover-fill: Skin.surface3;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: Skin.shadow;
                                    clicked => { root.flip(); }
                                    Path {
                                        width: 16px;
                                        height: 16px;
                                        viewbox-width: 16;
                                        viewbox-height: 16;
                                        commands: "M 5 2 L 5 13 M 2 10 L 5 13 L 8 10 M 11 14 L 11 3 M 8 6 L 11 3 L 14 6";
                                        stroke: Skin.ink;
                                        stroke-width: 1.6px;
                                        fill: transparent;
                                    }
                                }
                            }
                            want-leg := Leg {
                                label: "You want at least";
                                asset: root.assets[root.want-index];
                                amount <=> root.want-amount;
                                usd: root.want-usd;
                                pick-asset(right, bottom) => { root.open-popover("want", right, bottom); }
                            }
                            HorizontalLayout {
                                spacing: Sp.m;
                                padding-top: Sp.xs;
                                Text {
                                    text: "Solvers can answer for";
                                    color: Skin.muted;
                                    font-size: Ty.small;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    wrap: word-wrap;
                                }
                                Segmented {
                                    options: ["5 min", "10 min", "30 min"];
                                    selected <=> root.ttl-index;
                                }
                            }
                            if root.other-leg-state != "" && root.other-leg-state != "connect": Text {
                                text: root.other-leg;
                                color: Skin.muted;
                                font-size: Ty.small;
                                wrap: word-wrap;
                            }
                            if root.other-leg-state == "connect": Text {
                                text: root.other-leg;
                                color: Skin.accent-text;
                                font-size: Ty.small;
                                wrap: word-wrap;
                                TouchArea { mouse-cursor: pointer; clicked => { root.connect-wallet(); } }
                            }
                            if root.prices-state == "on" && root.price-note != "": Text {
                                text: root.price-note;
                                color: Skin.muted;
                                font-size: Ty.small;
                                wrap: word-wrap;
                            }
                            if root.prices-state == "asking": Text {
                                text: "Approve showing USD prices in Home…";
                                color: Skin.muted;
                                font-size: Ty.small;
                                wrap: word-wrap;
                            }
                            if root.prices-state == "off" || root.prices-state == "denied": Text {
                                text: root.prices-state == "denied" ? "USD prices were not approved. Ask again" : "Show USD prices";
                                color: Skin.accent-text;
                                font-size: Ty.small;
                                TouchArea { mouse-cursor: pointer; clicked => { root.show-prices(); } }
                            }
                            if root.form-error != "": Text {
                                text: root.form-error;
                                color: Skin.danger;
                                font-size: Ty.small;
                                wrap: word-wrap;
                            }
                            Button {
                                text: "Review swap";
                                clicked => { root.review(); }
                            }
                        }
                    }
                    if root.page == 3 && root.swap-on: Glass {
                        height: swap-card.preferred-height;
                        swap-card := SwapCard {
                            width: parent.width;
                            title: root.swap-title;
                            line: root.swap-line;
                            steps: root.swap-steps;
                            finished: root.swap-finished;
                            dismiss => { root.swap-dismiss(); }
                        }
                    }
                        if root.page == 3 && !root.swap-on: Glass {
                            height: empty.preferred-height;
                            empty := VerticalLayout {
                                padding: Sp.xl;
                                spacing: Sp.s;
                                Text { text: "No swaps yet"; color: Skin.ink; font-size: Ty.title; font-weight: Ty.strong; horizontal-alignment: center; }
                                Text {
                                    text: "Take an offer in Market, review it on Swap, and follow it here step by step.";
                                    color: Skin.muted;
                                    font-size: Ty.small;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    }
                }
            }

            // A phone: the places as a tab bar, always in reach.
            if !root.wide: Glass {
                height: 58px;
                vertical-stretch: 0;
                radius: 0px;
                floating: false;
                HorizontalLayout {
                    padding-left: Sp.s;
                    padding-right: Sp.s;
                    padding-top: 4px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    for tab in root.tabs: NavItem {
                        horizontal-stretch: 1;
                        label: tab.label;
                        icon: tab.icon;
                        active: root.page == tab.page;
                        dot: tab.page == 3 && root.swap-on && !root.swap-finished;
                        clicked => { root.page = tab.page; }
                    }
                }
            }
        }

        // A click outside an open asset popover closes it. The node panel is part of the layout
        // and closes from its chip or Escape.
        if root.popover == "give" || root.popover == "want": TouchArea {
            clicked => { root.popover = ""; }
        }

        Popover {
            open: root.popover == "give" || root.popover == "want";
            anchor-y: root.pop-top;
            width: 240px;
            x: max(Sp.s, root.pop-right - self.width);
            // At most what fits below its anchor; longer lists scroll inside the popover, not the page.
            height: min(asset-list.preferred-height, root.height - root.pop-top - Sp.l);
            Flickable {
                content-height: asset-list.preferred-height;
                content-width: self.width;
            asset-list := VerticalLayout {
                width: parent.width;
                padding: 6px;
                Text {
                    text: root.popover == "want" ? "You want" : "You give";
                    color: Skin.muted;
                    font-size: Ty.caption;
                    height: 28px;
                    vertical-alignment: center;
                    x: Sp.m;
                }
                for asset[i] in root.assets: Row {
                    title: asset.symbol;
                    subtitle: asset.network;
                    asset: asset;
                    with-face: true;
                    enabled: asset.offered;
                    opacity: asset.offered ? 1 : 0.45;
                    chosen: i == (root.popover == "want" ? root.want-index : root.give-index);
                    clicked => { root.pick-asset(root.popover, i); }
                }
            }
            }
        }

        // The review: a sheet over the dimmed app, sized to its content.
        Rectangle {
            background: Skin.scrim;
            opacity: root.review-open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { duration: Motion.overlay-in; easing: Motion.ease; }
            TouchArea { clicked => { root.review-open = false; } }
        }
        Glass {
            property <bool> narrow: root.width < 480px;
            // A reading surface: the tint denser than chrome (94 %).
            tint: 0.94;
            // As wide as the card under it, so none of the form shows at its sides.
            width: self.narrow ? root.width : min(lane.width, root.width - 2 * Sp.l);
            height: sheet.preferred-height;
            x: (root.width - self.width) / 2;
            y: (self.narrow ? root.height - self.height : (root.height - self.height) / 2) + (root.review-open ? 0px : Motion.overlay-rise);
            opacity: root.review-open ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity, y { duration: Motion.overlay-in; easing: Motion.ease; }
            sheet := VerticalLayout {
                padding: Sp.xl;
                spacing: Sp.m;
                Text {
                    text: "Review swap";
                    color: Skin.ink;
                    font-size: Ty.display;
                    font-weight: Ty.strong;
                }
                for item in [
                    { label: "You give", value: root.sum-give },
                    { label: "You want at least", value: root.sum-want },
                    { label: "Solvers can answer for", value: root.sum-until },
                ]: Rectangle {
                    border-radius: Rad.ctrl;
                    background: Skin.on-glass;
                    height: well.preferred-height;
                    well := VerticalLayout {
                        padding-top: Sp.m;
                        padding-bottom: Sp.m;
                        padding-left: Sp.l;
                        padding-right: Sp.l;
                        Text { text: item.label; color: Skin.muted; font-size: Ty.caption; }
                        Text { text: item.value; color: Skin.ink; font-size: Ty.body; font-weight: Ty.strong; wrap: word-wrap; }
                    }
                }
                Text {
                    text: root.send-note;
                    color: Skin.muted;
                    font-size: Ty.small;
                    wrap: word-wrap;
                }
                Text {
                    text: (root.show-json ? "▾ " : "▸ ") + "Message as signed";
                    color: Skin.accent-text;
                    font-size: Ty.small;
                    TouchArea { mouse-cursor: pointer; clicked => { root.show-json = !root.show-json; } }
                }
                if root.show-json: Rectangle {
                    border-radius: Rad.ctrl;
                    background: Skin.on-glass;
                    height: json.preferred-height + 2 * Sp.m;
                    json := Text {
                        x: Sp.m;
                        width: parent.width - 2 * Sp.m;
                        text: root.review-json;
                        color: Skin.muted;
                        font-size: 12px;
                        wrap: char-wrap;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Sp.s;
                    padding-top: Sp.xs;
                    Button {
                        text: "Edit";
                        primary: false;
                        clicked => { root.review-open = false; }
                    }
                    Button {
                        text: "Send to solver";
                        enabled: root.send-ready;
                        clicked => { root.send-swap(); }
                    }
                }
            }
        }
    }
}
