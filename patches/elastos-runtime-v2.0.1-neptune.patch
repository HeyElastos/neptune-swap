+/// Local Neptune development fork: the `peer` request neptune-swap may make,
+/// rebuilt from its body. Only its own topics (`neptune-swap`, or under
+/// `neptune-swap/` or `neptune-swap-`), at most `NEPTUNE_SWAP_TOPICS_PER_LAUNCH`
+/// joined per launch; the sender and receive cursor are the gateway's, derived
+/// from the launch and the topic (never the launch id itself, which stays off
+/// the network, and a different id on every topic), so the capsule cannot
+/// speak or read as anyone else and its messages on different topics do not
+/// link. Gossip timestamps, nonces and signatures are the provider's; the swap
+/// messages carry their own signatures.
+fn neptune_swap_peer_request(
+    op: &str,
+    body: &serde_json::Value,
+    launch_id: &str,
+) -> Result<serde_json::Value, String> {
+    let topic = || -> Result<String, String> {
+        let topic = body.get("topic").and_then(serde_json::Value::as_str).unwrap_or_default();
+        let ours = topic == NEPTUNE_SWAP_TOPIC_PREFIX
+            || topic.strip_prefix(NEPTUNE_SWAP_TOPIC_PREFIX).is_some_and(|rest| rest.starts_with('/') || rest.starts_with('-'));
+        let ok = ours
+            && topic.len() <= 128
+            && topic.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"-_./".contains(&b));
+        ok.then(|| topic.to_string()).ok_or_else(|| {
+            format!("topic must be {NEPTUNE_SWAP_TOPIC_PREFIX} or under {NEPTUNE_SWAP_TOPIC_PREFIX}/ or {NEPTUNE_SWAP_TOPIC_PREFIX}- (a-z, 0-9, -_./, at most 128)")
+        })
+    };
+    let party = |topic: &str| {
+        format!(
+            "neptune-swap:{}",
+            &hex::encode(sha2::Sha256::digest(format!("neptune-swap/peer/{launch_id}/{topic}")))[..16]
+        )
+    };
+    Ok(match op {
+        "gossip_join" | "gossip_leave" => {
+            let topic = topic()?;
+            let mut joined = NEPTUNE_SWAP_JOINED.lock().map_err(|_| "topic bookkeeping failed".to_string())?;
+            if joined.len() > 4096 {
+                joined.clear();
+            }
+            let mine = joined.entry(launch_id.to_string()).or_default();
+            if op == "gossip_join" {
+                if !mine.contains(&topic) && mine.len() >= NEPTUNE_SWAP_TOPICS_PER_LAUNCH {
+                    return Err(format!("at most {NEPTUNE_SWAP_TOPICS_PER_LAUNCH} topics at once; leave one first"));
+                }
+                mine.insert(topic.clone());
+            } else {
+                mine.remove(&topic);
+            }
+            serde_json::json!({ "op": op, "topic": topic })
+        }
+        "gossip_send" => {
+            let message = body.get("message").and_then(serde_json::Value::as_str).unwrap_or_default();
+            if message.is_empty() || message.len() > NEPTUNE_SWAP_MESSAGE_MAX_BYTES {
+                return Err(format!("message must be 1 to {NEPTUNE_SWAP_MESSAGE_MAX_BYTES} bytes"));
+            }
+            let topic = topic()?;
+            serde_json::json!({
+                "op": op, "topic": topic, "message": message,
+                "sender": NEPTUNE_SWAP_CAPSULE_ID, "sender_id": party(&topic),
+            })
+        }
+        "gossip_recv" => {
+            let limit = body.get("limit").and_then(serde_json::Value::as_u64).unwrap_or(50).clamp(1, 50);
+            let topic = topic()?;
+            let party = party(&topic);
+            serde_json::json!({
+                "op": op, "topic": topic, "limit": limit,
+                "consumer_id": party, "skip_sender_id": party,
+            })
+        }
+        _ => return Err("unsupported peer operation".into()),
+    })
+}
