+/// Local Neptune development fork: the only app the `neptune` scheme serves.
+const NEPTUNE_SWAP_CAPSULE_ID: &str = "neptune-swap";
+/// Local Neptune development fork: the carrier topics neptune-swap may use.
+const NEPTUNE_SWAP_TOPIC_PREFIX: &str = "neptune-swap";
+const NEPTUNE_SWAP_MESSAGE_MAX_BYTES: usize = 64 * 1024;
+
+/// Local Neptune development fork: `neptune/prices` asks public price sources
+/// (they see this computer's address), so the user approves it in Home first,
+/// as a capability request to the Home runtime. Granted once per gateway run.
+const NEPTUNE_PRICES_RESOURCE: &str = "elastos://neptune/prices";
+const NEPTUNE_PRICES_REASON: &str = "Neptune Swap wants to show prices in USD. It asks CoinGecko and Kraken, which see this computer's address and when it asks, never what you swap.";
+
+#[derive(Default)]
+struct NeptunePriceApproval {
+    granted: bool,
+    /// The open request and the attach token that made it.
+    pending: Option<(String, String)>,
+}
+
+static NEPTUNE_PRICE_APPROVAL: std::sync::OnceLock<tokio::sync::Mutex<NeptunePriceApproval>> =
+    std::sync::OnceLock::new();
+
+fn neptune_price_reply(status: StatusCode, code: &str, message: &str) -> Response {
+    (status, Json(serde_json::json!({ "status": "error", "code": code, "message": message }))).into_response()
+}
+
+/// Ok once the user has approved; otherwise the reply to send: 202 with
+/// `approval_pending` while Home asks, 403 `approval_denied` after a no (the
+/// next call asks again).
+async fn neptune_price_approval(data_dir: &std::path::Path) -> Result<(), Response> {
+    let mut approval = NEPTUNE_PRICE_APPROVAL.get_or_init(Default::default).lock().await;
+    if approval.granted {
+        return Ok(());
+    }
+    let unavailable =
+        |message: String| neptune_price_reply(StatusCode::SERVICE_UNAVAILABLE, "approval_unavailable", &message);
+    let coords = load_live_runtime_coords(data_dir)
+        .await
+        .ok_or_else(|| unavailable("the Home runtime is not running".into()))?;
+    let client = reqwest::Client::new();
+    let api = coords.api_url.trim_end_matches('/').to_string();
+    let mut status = serde_json::Value::Null;
+    if let Some((id, token)) = approval.pending.clone() {
+        let polled = client
+            .get(format!("{api}/api/capability/request/{id}"))
+            .bearer_auth(&token)
+            .send()
+            .await
+            .ok()
+            .filter(|r| r.status().is_success());
+        if let Some(reply) = polled {
+            status = reply.json().await.unwrap_or_default();
+        }
+    }
+    if status.is_null() {
+        let token = gateway_attach_runtime_token(&client, &api, &coords.attach_secret, "client")
+            .await
+            .map_err(|e| unavailable(e.to_string()))?;
+        status = client
+            .post(format!("{api}/api/capability/request"))
+            .bearer_auth(&token)
+            .json(&serde_json::json!({
+                "resource": NEPTUNE_PRICES_RESOURCE, "action": "read", "reason": NEPTUNE_PRICES_REASON,
+            }))
+            .send()
+            .await
+            .map_err(|e| unavailable(e.to_string()))?
+            .json()
+            .await
+            .map_err(|e| unavailable(e.to_string()))?;
+        if let Some(id) = status["request_id"].as_str() {
+            approval.pending = Some((id.to_string(), token));
+        }
+    }
+    match status["status"].as_str() {
+        _ if status["token"].is_string() => {
+            approval.granted = true;
+            approval.pending = None;
+            Ok(())
+        }
+        Some("granted") => {
+            approval.granted = true;
+            approval.pending = None;
+            Ok(())
+        }
+        Some("pending") => Err(neptune_price_reply(
+            StatusCode::ACCEPTED,
+            "approval_pending",
+            "Approve showing USD prices in Home.",
+        )),
+        other => {
+            approval.pending = None;
+            Err(neptune_price_reply(
+                StatusCode::FORBIDDEN,
+                "approval_denied",
+                &format!("USD prices were not approved ({})", other.unwrap_or("no answer")),
+            ))
+        }
+    }
+}
+
+/// Local Neptune development fork: the `peer` request neptune-swap may make,
+/// rebuilt from its body. Only its own topics; the sender and receive cursor
+/// are the gateway's, derived from the launch session (never the session id
+/// itself, which stays off the network), so the capsule cannot speak or read
+/// as anyone else. Gossip timestamps, nonces and signatures are the
+/// provider's; the swap messages carry their own signatures.
+fn neptune_swap_peer_request(
+    op: &str,
+    body: &serde_json::Value,
+    session_id: &str,
+) -> Result<serde_json::Value, String> {
+    let topic = || -> Result<String, String> {
+        let topic = body.get("topic").and_then(serde_json::Value::as_str).unwrap_or_default();
+        let ok = topic.starts_with(NEPTUNE_SWAP_TOPIC_PREFIX)
+            && topic.len() <= 128
+            && topic.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"-_./".contains(&b));
+        ok.then(|| topic.to_string())
+            .ok_or_else(|| format!("topic must start with {NEPTUNE_SWAP_TOPIC_PREFIX} (a-z, 0-9, -_./, at most 128)"))
+    };
+    let party = format!(
+        "neptune-swap:{}",
+        &hex::encode(sha2::Sha256::digest(format!("neptune-swap/peer/{session_id}")))[..16]
+    );
+    Ok(match op {
+        "get_ticket" => serde_json::json!({ "op": op }),
+        "gossip_join" | "gossip_leave" => serde_json::json!({ "op": op, "topic": topic()? }),
+        "gossip_join_exact" => {
+            let peers = body.get("peers").cloned().unwrap_or_else(|| serde_json::json!([]));
+            let valid = peers.as_array().is_some_and(|p| p.len() <= 16 && p.iter().all(serde_json::Value::is_string));
+            if !valid {
+                return Err("peers must be at most 16 endpoint ids".into());
+            }
+            serde_json::json!({ "op": op, "topic": topic()?, "peers": peers })
+        }
+        "gossip_send" => {
+            let message = body.get("message").and_then(serde_json::Value::as_str).unwrap_or_default();
+            if message.is_empty() || message.len() > NEPTUNE_SWAP_MESSAGE_MAX_BYTES {
+                return Err(format!("message must be 1 to {NEPTUNE_SWAP_MESSAGE_MAX_BYTES} bytes"));
+            }
+            serde_json::json!({
+                "op": op, "topic": topic()?, "message": message,
+                "sender": NEPTUNE_SWAP_CAPSULE_ID, "sender_id": party,
+            })
+        }
+        "gossip_recv" => {
+            let limit = body.get("limit").and_then(serde_json::Value::as_u64).unwrap_or(50).clamp(1, 50);
+            serde_json::json!({
+                "op": op, "topic": topic()?, "limit": limit,
+                "consumer_id": party, "skip_sender_id": party,
+            })
+        }
+        _ => return Err("unsupported peer operation".into()),
+    })
+}
