+/// Local Neptune development fork: the only app the `neptune` scheme serves.
+const NEPTUNE_INTENTS_CAPSULE_ID: &str = "neptune-intents";
+/// Local Neptune development fork: the carrier topics neptune-intents may use.
+const NEPTUNE_INTENTS_TOPIC_PREFIX: &str = "neptune-intents";
+const NEPTUNE_INTENTS_MESSAGE_MAX_BYTES: usize = 64 * 1024;
+
+/// Local Neptune development fork: the `peer` request neptune-intents may make,
+/// rebuilt from its body. Only its own topics; the sender and receive cursor
+/// are the gateway's, derived from the launch session (never the session id
+/// itself, which stays off the network), so the capsule cannot speak or read
+/// as anyone else. Gossip timestamps, nonces and signatures are the
+/// provider's; the swap messages carry their own signatures.
+fn neptune_intents_peer_request(
+    op: &str,
+    body: &serde_json::Value,
+    session_id: &str,
+) -> Result<serde_json::Value, String> {
+    let topic = || -> Result<String, String> {
+        let topic = body.get("topic").and_then(serde_json::Value::as_str).unwrap_or_default();
+        let ok = topic.starts_with(NEPTUNE_INTENTS_TOPIC_PREFIX)
+            && topic.len() <= 128
+            && topic.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"-_./".contains(&b));
+        ok.then(|| topic.to_string())
+            .ok_or_else(|| format!("topic must start with {NEPTUNE_INTENTS_TOPIC_PREFIX} (a-z, 0-9, -_./, at most 128)"))
+    };
+    let party = format!(
+        "neptune-intents:{}",
+        &hex::encode(sha2::Sha256::digest(format!("neptune-intents/peer/{session_id}")))[..16]
+    );
+    Ok(match op {
+        "get_ticket" => serde_json::json!({ "op": op }),
+        "gossip_join" | "gossip_leave" => serde_json::json!({ "op": op, "topic": topic()? }),
+        "gossip_join_exact" => {
+            let peers = body.get("peers").cloned().unwrap_or_else(|| serde_json::json!([]));
+            let valid = peers.as_array().is_some_and(|p| p.len() <= 16 && p.iter().all(serde_json::Value::is_string));
+            if !valid {
+                return Err("peers must be at most 16 endpoint ids".into());
+            }
+            serde_json::json!({ "op": op, "topic": topic()?, "peers": peers })
+        }
+        "gossip_send" => {
+            let message = body.get("message").and_then(serde_json::Value::as_str).unwrap_or_default();
+            if message.is_empty() || message.len() > NEPTUNE_INTENTS_MESSAGE_MAX_BYTES {
+                return Err(format!("message must be 1 to {NEPTUNE_INTENTS_MESSAGE_MAX_BYTES} bytes"));
+            }
+            serde_json::json!({
+                "op": op, "topic": topic()?, "message": message,
+                "sender": NEPTUNE_INTENTS_CAPSULE_ID, "sender_id": party,
+            })
+        }
+        "gossip_recv" => {
+            let limit = body.get("limit").and_then(serde_json::Value::as_u64).unwrap_or(50).clamp(1, 50);
+            serde_json::json!({
+                "op": op, "topic": topic()?, "limit": limit,
+                "consumer_id": party, "skip_sender_id": party,
+            })
+        }
+        _ => return Err("unsupported peer operation".into()),
+    })
+}
