+#[cfg(test)]
+mod neptune_intents_peer_tests {
+    use super::neptune_intents_peer_request as req;
+    use serde_json::json;
+
+    #[test]
+    fn only_its_own_topics() {
+        assert!(req("gossip_join", &json!({"topic": "neptune-intents/test"}), "s").is_ok());
+        for topic in ["chat", "home-services-requests", "neptune-intentsX", "neptune-intents/A", ""] {
+            assert!(req("gossip_join", &json!({ "topic": topic }), "s").is_err(), "{topic}");
+        }
+        assert!(req("connect", &json!({"topic": "neptune-intents"}), "s").is_err());
+    }
+
+    #[test]
+    fn the_gateway_picks_sender_and_cursor_from_the_session() {
+        let sent = req(
+            "gossip_send",
+            &json!({"topic": "neptune-intents", "message": "x", "sender_id": "solver", "signature": "s", "ts": 1}),
+            "session-a",
+        )
+        .unwrap();
+        let party = sent["sender_id"].as_str().unwrap();
+        assert!(party.starts_with("neptune-intents:") && !party.contains("session-a"));
+        assert!(sent.get("signature").is_none() && sent.get("ts").is_none());
+        let recv = req("gossip_recv", &json!({"topic": "neptune-intents", "consumer_id": "solver", "limit": 999}), "session-a").unwrap();
+        assert_eq!((recv["consumer_id"].as_str(), recv["skip_sender_id"].as_str()), (Some(party), Some(party)));
+        assert_eq!(recv["limit"], 50);
+        let other = req("gossip_recv", &json!({"topic": "neptune-intents"}), "session-b").unwrap();
+        assert_ne!(other["consumer_id"].as_str(), Some(party));
+    }
+
+    #[test]
+    fn messages_are_bounded() {
+        let big = "a".repeat(64 * 1024 + 1);
+        assert!(req("gossip_send", &json!({"topic": "neptune-intents", "message": big}), "s").is_err());
+        assert!(req("gossip_send", &json!({"topic": "neptune-intents", "message": ""}), "s").is_err());
+        let peers: Vec<String> = (0..17).map(|i| i.to_string()).collect();
+        assert!(req("gossip_join_exact", &json!({"topic": "neptune-intents", "peers": peers}), "s").is_err());
+    }
+}
