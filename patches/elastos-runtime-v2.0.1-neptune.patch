+/// Local Neptune development fork: the only app the `neptune` scheme serves.
+const NEPTUNE_SWAP_CAPSULE_ID: &str = "neptune-swap";
+/// Local Neptune development fork: the carrier topics neptune-swap may use.
+const NEPTUNE_SWAP_TOPIC_PREFIX: &str = "neptune-swap";
+const NEPTUNE_SWAP_MESSAGE_MAX_BYTES: usize = 64 * 1024;
+/// Topics one launch of the app may have joined at once.
+const NEPTUNE_SWAP_TOPICS_PER_LAUNCH: usize = 4;
+static NEPTUNE_SWAP_JOINED: std::sync::Mutex<
+    std::collections::BTreeMap<String, std::collections::BTreeSet<String>>,
+> = std::sync::Mutex::new(std::collections::BTreeMap::new());
+
+/// Local Neptune development fork: `neptune/prices` asks public price sources
+/// (they see this computer's address), so the user approves it in Home first,
+/// as a capability request to the Home runtime. Granted once per gateway run.
+const NEPTUNE_PRICES_RESOURCE: &str = "elastos://neptune/prices";
+const NEPTUNE_PRICES_REASON: &str = "Neptune Swap wants to show prices in USD. It asks CoinGecko and Kraken, which see this computer's address and when it asks, never what you swap.";
+
+/// One user's answer: granted until, refused until, or a request still open
+/// (with the attach token that made it, so it is polled, never asked again).
+#[derive(Default)]
+struct NeptunePriceApproval {
+    granted_until: u64,
+    denied_until: u64,
+    pending: Option<(String, String)>,
+}
+
+/// How long a yes lasts, and how long a no stops the app from asking again.
+const NEPTUNE_PRICES_GRANT_SECS: u64 = 12 * 3600;
+const NEPTUNE_PRICES_DENIED_SECS: u64 = 10 * 60;
+
+static NEPTUNE_PRICE_APPROVALS: std::sync::OnceLock<
+    tokio::sync::Mutex<std::collections::HashMap<String, NeptunePriceApproval>>,
+> = std::sync::OnceLock::new();
+
+fn neptune_price_reply(status: StatusCode, code: &str, message: &str) -> Response {
+    (status, Json(serde_json::json!({ "status": "error", "code": code, "message": message }))).into_response()
+}
+
+/// Ok once this user (`principal_id`) has approved; otherwise the reply to
+/// send: 202 `approval_pending` while Home asks, 403 `approval_denied` after
+/// a no (for ten minutes, without asking again). One request at a time per
+/// user; a poll that fails leaves it pending; every call has a timeout.
+async fn neptune_price_approval(data_dir: &std::path::Path, principal_id: &str) -> Result<(), Response> {
+    let now = crate::auth::now_ts();
+    let mut approvals = NEPTUNE_PRICE_APPROVALS.get_or_init(Default::default).lock().await;
+    if approvals.len() > 1024 {
+        approvals.retain(|_, a| a.granted_until > now || a.denied_until > now || a.pending.is_some());
+    }
+    let approval = approvals.entry(principal_id.to_string()).or_default();
+    if approval.granted_until > now {
+        return Ok(());
+    }
+    let pending_reply = || neptune_price_reply(StatusCode::ACCEPTED, "approval_pending", "Approve showing USD prices in Home.");
+    if approval.denied_until > now {
+        return Err(neptune_price_reply(StatusCode::FORBIDDEN, "approval_denied", "USD prices were not approved."));
+    }
+    let unavailable =
+        |message: String| neptune_price_reply(StatusCode::SERVICE_UNAVAILABLE, "approval_unavailable", &message);
+    let coords = load_live_runtime_coords(data_dir)
+        .await
+        .ok_or_else(|| unavailable("the Home runtime is not running".into()))?;
+    let client = reqwest::Client::builder()
+        .timeout(std::time::Duration::from_secs(10))
+        .build()
+        .map_err(|e| unavailable(e.to_string()))?;
+    let api = coords.api_url.trim_end_matches('/').to_string();
+    let status: serde_json::Value = if let Some((id, token)) = approval.pending.clone() {
+        match client.get(format!("{api}/api/capability/request/{id}")).bearer_auth(&token).send().await {
+            Ok(reply) if reply.status() == reqwest::StatusCode::NOT_FOUND => {
+                // The runtime no longer knows it (expired, restarted): ask anew next time.
+                approval.pending = None;
+                return Err(pending_reply());
+            }
+            Ok(reply) if reply.status().is_success() => reply.json().await.unwrap_or_default(),
+            // Any other failure: still pending, never a new request.
+            _ => return Err(pending_reply()),
+        }
+    } else {
+        let token = gateway_attach_runtime_token(&client, &api, &coords.attach_secret, "client")
+            .await
+            .map_err(|e| unavailable(e.to_string()))?;
+        let asked: serde_json::Value = client
+            .post(format!("{api}/api/capability/request"))
+            .bearer_auth(&token)
+            .json(&serde_json::json!({
+                "resource": NEPTUNE_PRICES_RESOURCE, "action": "read", "reason": NEPTUNE_PRICES_REASON,
+            }))
+            .send()
+            .await
+            .map_err(|e| unavailable(e.to_string()))?
+            .json()
+            .await
+            .map_err(|e| unavailable(e.to_string()))?;
+        if let Some(id) = asked["request_id"].as_str() {
+            approval.pending = Some((id.to_string(), token));
+        }
+        asked
+    };
+    let granted = status["token"].is_string() || status["status"] == "granted";
+    match status["status"].as_str() {
+        _ if granted => {
+            approval.granted_until = now + NEPTUNE_PRICES_GRANT_SECS;
+            approval.pending = None;
+            Ok(())
+        }
+        Some("pending") => Err(pending_reply()),
+        other => {
+            approval.pending = None;
+            approval.denied_until = now + NEPTUNE_PRICES_DENIED_SECS;
+            Err(neptune_price_reply(
+                StatusCode::FORBIDDEN,
+                "approval_denied",
+                &format!("USD prices were not approved ({})", other.unwrap_or("no answer")),
+            ))
+        }
+    }
+}
