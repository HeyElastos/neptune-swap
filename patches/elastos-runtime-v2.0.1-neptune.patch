+    fn a_launch_joins_a_few_topics_at_most() {
+        for i in 0..super::NEPTUNE_SWAP_TOPICS_PER_LAUNCH {
+            assert!(req("gossip_join", &json!({ "topic": format!("neptune-swap/t{i}") }), "many").is_ok());
+        }
+        assert!(req("gossip_join", &json!({"topic": "neptune-swap/one-more"}), "many").is_err());
+        assert!(req("gossip_join", &json!({"topic": "neptune-swap/t0"}), "many").is_ok(), "already joined");
+        assert!(req("gossip_leave", &json!({"topic": "neptune-swap/t0"}), "many").is_ok());
+        assert!(req("gossip_join", &json!({"topic": "neptune-swap/one-more"}), "many").is_ok());
+        assert!(req("gossip_join", &json!({"topic": "neptune-swap/t9"}), "other-launch").is_ok());
+    }
+
+    #[test]
+    fn the_gateway_picks_sender_and_cursor_from_the_session() {
+        let sent = req(
+            "gossip_send",
+            &json!({"topic": "neptune-swap", "message": "x", "sender_id": "solver", "signature": "s", "ts": 1}),
+            "session-a",
+        )
+        .unwrap();
+        let party = sent["sender_id"].as_str().unwrap();
+        assert!(party.starts_with("neptune-swap:") && !party.contains("session-a"));
+        assert!(sent.get("signature").is_none() && sent.get("ts").is_none());
+        let recv = req("gossip_recv", &json!({"topic": "neptune-swap", "consumer_id": "solver", "limit": 999}), "session-a").unwrap();
+        assert_eq!((recv["consumer_id"].as_str(), recv["skip_sender_id"].as_str()), (Some(party), Some(party)));
+        assert_eq!(recv["limit"], 50);
+        let other = req("gossip_recv", &json!({"topic": "neptune-swap"}), "session-b").unwrap();
+        assert_ne!(other["consumer_id"].as_str(), Some(party));
+        // Another topic, another sender id: nothing links the two.
+        let elsewhere = req("gossip_recv", &json!({"topic": "neptune-swap/offers/main"}), "session-a").unwrap();
+        assert_ne!(elsewhere["consumer_id"].as_str(), Some(party));
+    }
+
+    #[test]
+    fn messages_are_bounded() {
+        let big = "a".repeat(64 * 1024 + 1);
+        assert!(req("gossip_send", &json!({"topic": "neptune-swap", "message": big}), "s").is_err());
+        assert!(req("gossip_send", &json!({"topic": "neptune-swap", "message": ""}), "s").is_err());
+    }
+}
