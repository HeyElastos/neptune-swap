diff --git a/neptune-consensus/src/proof_abstractions/triton_vm_job_queue.rs b/neptune-consensus/src/proof_abstractions/triton_vm_job_queue.rs
index e33f6df..119bd85 100644
--- a/neptune-consensus/src/proof_abstractions/triton_vm_job_queue.rs
+++ b/neptune-consensus/src/proof_abstractions/triton_vm_job_queue.rs
@@ -82,7 +82,14 @@ fn worker_runtime() -> &'static tokio::runtime::Runtime {
     use std::sync::OnceLock;
     static RUNTIME: OnceLock<tokio::runtime::Runtime> = OnceLock::new();
     RUNTIME.get_or_init(|| {
-        tokio::runtime::Builder::new_multi_thread()
+        // wasm32 (light wallet patch): no threads, so the queue gets a
+        // current-thread runtime. Nothing drives it there; light wallets
+        // never queue Triton VM jobs.
+        #[cfg(target_arch = "wasm32")]
+        let mut builder = tokio::runtime::Builder::new_current_thread();
+        #[cfg(not(target_arch = "wasm32"))]
+        let mut builder = tokio::runtime::Builder::new_multi_thread();
+        builder
             .enable_all()
             .thread_name("triton-vm-job-queue")
             .build()
